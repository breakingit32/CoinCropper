# Copy to .env and fill in.  .env is git-ignored.

# "mock" = demo prices, "live" = sign in to CCE with your member account
CCE_MODE=mock
CCE_USER_ID=
CCE_PASSWORD=
# Member page that shows bids for one coin (see README "Connecting to CCE").
# Placeholders: {pcgs_no} {grade} {grade_num} {service} {cert} {barcode} {query}
CCE_SEARCH_URL=

# Optional grading APIs. PCGS_API_TOKEN may list several keys (comma separated).
PCGS_API_TOKEN=
CACG_API_KEY=
CACG_API_TOKEN=
